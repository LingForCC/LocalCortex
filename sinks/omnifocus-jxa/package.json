{
  "name": "@localcortex/omnifocus-jxa",
  "version": "0.1.0",
  "description": "Custom thin MCP server wrapping OmniFocus via JXA (JavaScript for Automation). Spawns as a stdio child process by LocalCortex rules.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "omnifocus-jxa-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/scripts','dist/scripts',{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.8.3"
  }
}
